local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

if localPlayer.Name ~= "3r_q5" and localPlayer.Name ~= "5_6ry" then
    return
end

local POS_KILL = Vector3.new(216, 100, 339)
local POS_KICK = Vector3.new(283, 191, 333)
local POS_LAG  = Vector3.new(172, 138, 722)

local RADIUS = 20
local CUBE_SIZE = Vector3.new(RADIUS * 2, RADIUS * 2, RADIUS * 2)

local function createVisualZone(position, color, name)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = CUBE_SIZE
    part.Position = position
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.BrickColor = BrickColor.new(color)
    part.Material = Enum.Material.Neon
    part.Parent = workspace
end

createVisualZone(POS_KILL, "Bright red", "VisualKillZone")
createVisualZone(POS_KICK, "Bright blue", "VisualKickZone")
createVisualZone(POS_LAG, "Bright yellow", "VisualLagZone")

local lastLagTick = 0
local lagEffectEndTime = 0

RunService.Heartbeat:Connect(function()
    local currentTime = os.clock()
    local inKillZone = false
    local inLagZone = false
    
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local pos = character.HumanoidRootPart.Position
            
            if (pos - POS_KILL).Magnitude <= RADIUS then
                inKillZone = true
            end
            
            if (pos - POS_KICK).Magnitude <= RADIUS then
                game:Shutdown()
            end
            
            if (pos - POS_LAG).Magnitude <= RADIUS then
                inLagZone = true
                lagEffectEndTime = currentTime + 4
            end
        end
    end
    
    if inKillZone then
        local localChar = localPlayer.Character
        if localChar and localChar:FindFirstChildOfClass("Humanoid") then
            localChar:FindFirstChildOfClass("Humanoid").Health = 0
        end
    end
    
    if currentTime < lagEffectEndTime then
        if currentTime - lastLagTick >= 0.01 then
            lastLagTick = currentTime
            if setfpscap then
                setfpscap(math.random(4, 12))
            end
        end
    else
        if setfpscap then
            setfpscap(0)
        end
    end
end)
